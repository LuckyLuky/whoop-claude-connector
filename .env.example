# Public HTTPS origin of this deployment, no trailing slash. Must match the
# URL you enter in Claude (minus the /mcp path). For local dev, a tunnel URL.
APP_BASE_URL=https://your-domain.example

# WHOOP developer app — https://developer-dashboard.whoop.com
# Register https://<APP_BASE_URL>/callback as the redirect URI.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# The one WHOOP account allowed to connect. Leave empty for your first
# sign-in: the callback page shows your user id and asks you to set it.
ALLOWED_WHOOP_USER_ID=

# IANA timezone used to resolve YYYY-MM-DD dates into UTC windows.
WHOOP_TIMEZONE=Europe/Prague

# Optional. Webhook signatures fall back to WHOOP_CLIENT_SECRET when unset.
WHOOP_WEBHOOK_SECRET=

# Supabase project — Settings → API. The service role key bypasses RLS;
# never expose it to a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Rotating it makes stored WHOOP tokens unreadable (you'd reconnect).
TOKEN_ENCRYPTION_KEY=
